diff -ruN -x check before/src/pricing.js after/src/pricing.js
--- before/src/pricing.js
+++ after/src/pricing.js
@@ -1,3 +1,9 @@
 export function applyDiscount(amount, percent) {
+  if (typeof amount !== 'number' || !Number.isFinite(amount)) {
+    throw new TypeError(`amount must be a finite number, got ${amount}`);
+  }
+  if (!(percent >= 0 && percent <= 100)) {
+    throw new RangeError(`percent must be between 0 and 100, got ${percent}`);
+  }
   return Math.round(amount * (100 - percent)) / 100;
 }
