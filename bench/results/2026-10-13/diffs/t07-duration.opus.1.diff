diff -ruN -x check before/src/duration.js after/src/duration.js
--- before/src/duration.js
+++ after/src/duration.js
@@ -1,6 +1,10 @@
-// Parses durations like "2h" into seconds.
+// Parses durations like "2h", "1h30m", "45s" or "1h2m3s" into seconds.
 export function parseDuration(text) {
-  const m = /^(\d+)h$/.exec(text.trim());
-  if (!m) throw new Error(`Bad duration: ${text}`);
-  return Number(m[1]) * 3600;
+  const m = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(text.trim());
+  // All groups are optional, so reject the empty match explicitly.
+  if (!m || (m[1] === undefined && m[2] === undefined && m[3] === undefined)) {
+    throw new Error(`Bad duration: ${text}`);
+  }
+  const [h, min, s] = [m[1], m[2], m[3]].map((v) => Number(v ?? 0));
+  return h * 3600 + min * 60 + s;
 }
