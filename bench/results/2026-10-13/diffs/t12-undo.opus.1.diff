diff -ruN -x check before/src/editor.js after/src/editor.js
--- before/src/editor.js
+++ after/src/editor.js
@@ -1,13 +1,39 @@
+const MAX_UNDO = 50;
+
 export class Editor {
   constructor(text = '') {
     this.text = text;
+    this.undoStack = [];
+    this.redoStack = [];
   }
 
   insert(pos, str) {
+    this._record();
     this.text = this.text.slice(0, pos) + str + this.text.slice(pos);
   }
 
   delete(pos, len) {
+    this._record();
     this.text = this.text.slice(0, pos) + this.text.slice(pos + len);
+  }
+
+  undo() {
+    if (this.undoStack.length === 0) return;
+    this.redoStack.push(this.text);
+    this.text = this.undoStack.pop();
+  }
+
+  redo() {
+    if (this.redoStack.length === 0) return;
+    this.undoStack.push(this.text);
+    this.text = this.redoStack.pop();
+  }
+
+  // Snapshot the text before an edit so undo restores it exactly,
+  // even when pos/len fall outside the string and slice() clamps them.
+  _record() {
+    this.undoStack.push(this.text);
+    if (this.undoStack.length > MAX_UNDO) this.undoStack.shift();
+    this.redoStack = [];
   }
 }
