+const MAX_UNDO = 50;
+
 export class Editor {
   constructor(text = '') {
     this.text = text;
+    this.undoStack = [];
+    this.redoStack = [];
   }
 
   insert(pos, str) {
-    this.text = this.text.slice(0, pos) + str + this.text.slice(pos);
+    this.#apply(this.text.slice(0, pos) + str + this.text.slice(pos));
   }
 
   delete(pos, len) {
-    this.text = this.text.slice(0, pos) + this.text.slice(pos + len);
+    this.#apply(this.text.slice(0, pos) + this.text.slice(pos + len));
+  }
+
+  undo() {
+    if (this.undoStack.length === 0) return;
+    this.redoStack.push(this.text);
+    this.text = this.undoStack.pop();
+  }
+
+  redo() {
+    if (this.redoStack.length === 0) return;
+    this.undoStack.push(this.text);
+    this.text = this.redoStack.pop();
+  }
+
+  // Records the current text as an undo step, then applies the edit.
+  // Edits that don't change the text are ignored so they can't create empty undo steps.
+  #apply(next) {
+    if (next === this.text) return;
+    this.undoStack.push(this.text);
+    if (this.undoStack.length > MAX_UNDO) this.undoStack.shift();
+    this.redoStack = [];
+    this.text = next;
   }
 }
